FIREFLY_URL=http://localhost:8080
FIREFLY_TOKEN=replace-with-your-personal-access-token

# Token independente para POST /upload. Vazio desativa o servidor HTTP.
UPLOAD_TOKEN=
# Porta interna do Express (também usada na execução local).
HTTP_PORT=3000
# Porta publicada pelo Docker no host.
HTTP_HOST_PORT=3000

# Prefixo do nome das contas do Wise no FF3
WISE_FF3_ACCT_PREFIX="Wisetest"

# Nome da conta de investimentos do Bradesco no FF3. Usado pra baixa automatica de rendimentos
BRADESCO_INVESTIMENTOS_FF3_ACCT_NAME="Bradesco - Investimentos"

# Numero da conta da avenue. Usado pra converter withdralwal em transfer
AVENUE_ACCT_NO="(084106768) 96**********4609"
AVENUE_FF3_ACCT_NAME="Avenue - Investimentos"

# Nome da conta de transferencia Pix do Bradesco pro Wise
WISE_REMETENTE_PIX="BRUNO SAAD MARQUES"
WISE_REMETENTE_PIX_FF3_ACCT_NAME="Bradesco 5"
